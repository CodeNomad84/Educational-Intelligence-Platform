# Copy to .env and fill in LOCAL values. Never commit real values.
# .env is read by Django/Celery/Postgres and used for ${...} interpolation in docker-compose.yml.

# =============================================================================
# Domains — single source of truth (dynamic domain hardening)
# -----------------------------------------------------------------------------
# Change ONLY the two APP_DOMAIN_* values below to re-point both sites. Compose
# derives the nginx gateway `server_name` (MEN_HOST/WOMEN_HOST) and Django's
# ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS / CORS_ALLOWED_ORIGINS from them, so no
# other file needs a manual search-and-replace. Run `docker compose up -d` after
# a change (the gateway and django services pick up the new values).
#
#   APP_DOMAIN_MEN    -> boys'  app host (nginx + Django trusted host/origin)
#   APP_DOMAIN_WOMEN  -> girls' app host (nginx + Django trusted host/origin)
#   API_BASE_URL      -> client-side API base. The Vite apps call `/api` on their
#                        own origin (same-origin through the gateway), so keep
#                        `/api` unless the API moves to a separate origin.
# =============================================================================
APP_DOMAIN_MEN=men.example.ir
APP_DOMAIN_WOMEN=women.example.ir
API_BASE_URL=/api

# Wire-level hostnames rendered into the nginx gateway template (kept in sync
# with APP_DOMAIN_* above; compose prefers APP_DOMAIN_* and falls back to these).
MEN_HOST=men.example.ir
WOMEN_HOST=women.example.ir

# Django trusted hosts/origins — both app hosts, https:// origins only (deploy
# check eip.E002). Kept as one block next to APP_DOMAIN_* so the two stay in sync.
# ALLOWED_HOSTS may keep `localhost,127.0.0.1` for the loopback debug port during
# local development; remove them on a real server.
ALLOWED_HOSTS=localhost,127.0.0.1,men.example.ir,women.example.ir
CSRF_TRUSTED_ORIGINS=https://men.example.ir,https://women.example.ir
CORS_ALLOWED_ORIGINS=https://men.example.ir,https://women.example.ir

SECRET_KEY=
DB_NAME=school_db
DB_ADMIN_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
DJANGO_SETTINGS_MODULE=config.settings.production

# Kept OUT of .env, in separate gitignored files (generate each value with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"):
#   .env.service  ->  SERVICE_JWT_SECRET=<random, >= 32 chars; shared by Django and FastAPI only; must differ from SECRET_KEY>
#   .env.minio    ->  MINIO_ROOT_USER=<non-default>   MINIO_ROOT_PASSWORD=<random>
#   .env.llm      ->  AI providers for the fastapi service only (copy .env.llm.example; empty = AI OFF; docs/AI_GOVERNANCE.md)
