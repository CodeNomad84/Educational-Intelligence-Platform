# Copy to .env and fill in LOCAL values. Never commit real values.
# .env is read by Django/Celery/Postgres and used for ${...} interpolation in docker-compose.yml.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=school_db
DB_USER=school_user
DB_PASSWORD=
DB_HOST=postgres
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=
DJANGO_SETTINGS_MODULE=config.settings.production

# Kept OUT of .env, in separate gitignored files (generate each value with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"):
#   .env.service  ->  SERVICE_JWT_SECRET=<random, >= 32 chars; shared by Django and FastAPI only; must differ from SECRET_KEY>
#   .env.minio    ->  MINIO_ROOT_USER=<non-default>   MINIO_ROOT_PASSWORD=<random>
