# Profile "shared": ONE platform installation on a shared Iranian server hosting several schools (decision pack OW-1, OW-3).
# Copy to a file OUTSIDE the repository, fill every CHANGE_ME with a long random value, then run: scripts/preflight.py <file> --profile shared
# Never commit the filled file. No value below is a real secret.
SECRET_KEY=CHANGE_ME_django_secret_at_least_50_random_characters
SERVICE_JWT_SECRET=CHANGE_ME_service_token_secret_at_least_32_random_characters
DB_ADMIN_PASSWORD=CHANGE_ME_postgres_bootstrap_superuser_16plus
DB_OWNER_PASSWORD=CHANGE_ME_school_owner_role_16plus
DB_APP_PASSWORD=CHANGE_ME_school_app_role_16plus
DB_NAME=school_db
# the platform's own domain (.ir) and the schools' sub-domains; real names only, https only
ALLOWED_HOSTS=platform.example.ir
CSRF_TRUSTED_ORIGINS=https://platform.example.ir
SECURE_HSTS_SECONDS=3600
# reverse proxy addresses (nginx on the same host) so the login throttle sees real client addresses
THROTTLE_TRUSTED_PROXIES=127.0.0.1
# public half of the offline backup key (scripts/backup.sh); the private half is held by the owner
EIP_BACKUP_PUBKEY=/etc/eip/backup-public.asc
# AI is OFF by default; see docs/AI_GOVERNANCE.md before setting anything (keys only in LLM_KEY_* variables, never in this repository)
