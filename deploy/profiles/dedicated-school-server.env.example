# Profile "dedicated": one school on the school's OWN server (decision pack OW-1), the school names its operator. Same files, one school.
# Fill every CHANGE_ME outside the repository, then: scripts/preflight.py <file> --profile dedicated
SECRET_KEY=CHANGE_ME_django_secret_at_least_50_random_characters
SERVICE_JWT_SECRET=CHANGE_ME_service_token_secret_at_least_32_random_characters
DB_ADMIN_PASSWORD=CHANGE_ME_postgres_bootstrap_superuser_16plus
DB_OWNER_PASSWORD=CHANGE_ME_school_owner_role_16plus
DB_APP_PASSWORD=CHANGE_ME_school_app_role_16plus
DB_NAME=school_db
# the school's own domain (or a sub-domain of the platform's)
ALLOWED_HOSTS=school.example.ir
CSRF_TRUSTED_ORIGINS=https://school.example.ir
SECURE_HSTS_SECONDS=3600
THROTTLE_TRUSTED_PROXIES=127.0.0.1
EIP_BACKUP_PUBKEY=/etc/eip/backup-public.asc
# create the school once with: manage.py create_school (docs/manuals/platform-admin.md); no second school on this server
# AI providers, if any, are configured in .env.llm (copy .env.llm.example) for the fastapi service only; this profile file
# never carries a provider key (change 0043, ADR-0008).
