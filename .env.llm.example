# AI provider configuration for the FastAPI service ONLY (change 0043, ADR-0008).
# Copy this file to .env.llm (gitignored) on the server, fill in the values, then restart the fastapi service.
#   cp .env.llm.example .env.llm && chmod 600 .env.llm
# Rules: docs/AI_GOVERNANCE.md and docs/adr/0008-llm-provider-and-egress.md.
#   * Django does not read this file and never receives these variables; the FastAPI adapter is the only egress point.
#   * AI stays OFF while LLM_SCHOOL_MAP is empty, even if a provider is listed below.
#   * Never put real student data, a student record or counseling content in a prompt for an `external` provider.
#   * The key must be named LLM_KEY_* (fastapi_core/llm_adapter.py:36); it is never logged or returned.
# Values below are PLACEHOLDERS. Confirm base_url and model with the provider's own documentation before use:
# the provider's endpoint, model ids, data retention and residency are NOT VERIFIED by this repository.

# 1) The key. Leave empty here; put the real value only in .env.llm on the server.
LLM_KEY_GAPGPT=

# 2) Providers (JSON, one line per variable). class: external = data leaves the platform (4 non-personal purposes only);
#    local = runs on this server (may also answer document_qa). timeout 1-60 s, max_tokens 1-4000.
LLM_PROVIDERS={"gapgpt": {"class": "external", "base_url": "https://api.gapgpt.app/v1", "model": "gpt-4o-mini", "api_key_env": "LLM_KEY_GAPGPT", "timeout": 30, "max_tokens": 600}}

# 3) School -> provider (JSON). Empty = NO school has AI. A school not listed has no AI. Map a school only after
#    the provider's retention terms have been recorded as a decision.
LLM_SCHOOL_MAP={}

# 4) Calls per school per UTC day (0 = block all). Defence in depth only: the licensed caps are enforced in Django
#    (schools/ai_guard.py: School.ai_daily_cap / ai_monthly_cap).
LLM_DAILY_CAP=100
